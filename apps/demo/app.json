{
  "id": "demo",
  "name": "Applicator Applet Demo",
  "version": {
    "major": 1,
    "minor": 0,
    "dev": 0
  },
  "author": "Matthew Morgan",
  "contactEmail": "matthew@morgantech.info",
  "description": "A comprehensive demonstration app showcasing the Applicator platform's capabilities including tables, authorities, hooks, and agents.",
  "dependencies": {
    "files": {
      "major": 1,
      "minor": 0,
      "dev": 0
    }
  },
  "tables": [
    {
      "name": "demo-item",
      "description": "Demo items showcasing various field types",
      "fields": [
        {
          "name": "title",
          "description": "Item title",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "description": "Item description",
          "type": "string"
        },
        {
          "name": "status",
          "description": "Current status (draft, active, archived)",
          "type": "picklist",
          "required": true,
          "defaultValue": "draft",
          "options": ["draft", "active", "archived"]
        },
        {
          "name": "createdAt",
          "description": "Creation date",
          "type": "date",
          "required": true
        },
        {
          "name": "metadata",
          "description": "Additional metadata as JSON",
          "type": "json",
          "defaultValue": {}
        },
        {
          "name": "createdBy",
          "description": "User who created this item",
          "type": "relationship",
          "relatedTo": "system:user",
          "required": true
        },
        {
          "name": "assignedTo",
          "description": "User this item is assigned to",
          "type": "relationship",
          "relatedTo": "system:user"
        }
      ]
    },
    {
      "name": "user-color",
      "description": "User-specific color preference",
      "fields": [
        {
          "name": "userId",
          "description": "The user this color preference belongs to",
          "type": "relationship",
          "relatedTo": "system:user",
          "required": true
        },
        {
          "name": "color",
          "description": "The selected color value (hex format)",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "system-color",
      "description": "System-wide color preference",
      "fields": [
        {
          "name": "color",
          "description": "The system color value (hex format)",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "authorizations": [
    {
      "id": "view",
      "name": "View Demo Items",
      "description": "Can view demo items",
      "contextual": false,
      "target": "user"
    },
    {
      "id": "manage",
      "name": "Manage Demo Items",
      "description": "Can create, edit, and delete demo items",
      "contextual": false,
      "target": "user"
    },
    {
      "id": "admin",
      "name": "Demo Administration",
      "description": "Full administrative access to all demo features",
      "contextual": true,
      "target": "user"
    },
    {
      "id": "agent-control",
      "name": "Agent Control",
      "description": "Can control demo agents",
      "contextual": false,
      "target": "app"
    }
  ],
  "authorities": [
    {
      "id": "demo-viewer",
      "name": "Demo Viewer",
      "authorizations": ["demo:view"]
    },
    {
      "id": "demo-administrator",
      "name": "Demo Administrator",
      "authorizations": ["demo:view", "demo:manage", "demo:admin"]
    }
  ],
  "agents": [
    {
      "name": "debug-logger",
      "description": "Logs a debug message every minute to demonstrate scheduled agent execution",
      "cron": "* * * * *"
    },
    {
      "name": "ping-pong",
      "description": "Responds to ping messages with pong, and echoes other messages back to the user"
    }
  ],
  "apiRoutes": [
    {
      "path": "items/list",
      "method": "GET",
      "description": "List all demo items"
    },
    {
      "path": "items/create",
      "method": "POST",
      "description": "Create a new demo item"
    },
    {
      "path": "ping",
      "method": "POST",
      "description": "Send a message to the ping-pong agent"
    },
    {
      "path": "messages",
      "method": "GET",
      "description": "Get recent messages from the ping-pong agent"
    },
    {
      "path": "settings/user-color",
      "method": "GET",
      "description": "Get user's color preference"
    },
    {
      "path": "settings/user-color",
      "method": "POST",
      "description": "Save user's color preference"
    },
    {
      "path": "settings/system-color",
      "method": "GET",
      "description": "Get system color preference"
    },
    {
      "path": "settings/system-color",
      "method": "POST",
      "description": "Save system color preference"
    }
  ],
  "applets": [
    {
      "id": "dashboard",
      "label": "Demo Dashboard",
      "description": "Main dashboard demonstrating platform features",
      "target": "app",
      "component": "Dashboard"
    },
    {
      "id": "ping-pong",
      "label": "Ping Pong",
      "description": "Interactive ping-pong messaging demo",
      "target": "app",
      "component": "PingPong"
    },
    {
      "id": "user-settings",
      "label": "Demo Color",
      "description": "Set your personal color preference",
      "target": "user-settings",
      "component": "UserSettingsWidget"
    },
    {
      "id": "system-settings",
      "label": "Demo Settings",
      "description": "Configure system-wide color settings",
      "target": "system-settings",
      "component": "SystemSettingsWidget"
    }
  ]
}
