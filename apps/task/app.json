{
  "id": "task",
  "name": "Task Manager",
  "version": {
    "major": 1,
    "minor": 1,
    "dev": 3
  },
  "author": "Vibe Applicator",
  "contactEmail": "support@vibeapplicator.com",
  "description": "Manage tasks with assignments, priorities, and status tracking",
  "dependencies": {
    "files": {
      "major": 1,
      "minor": 0,
      "dev": 0
    }
  },
  "tables": [
    {
      "name": "task",
      "description": "Task records with assignments, priorities, and status tracking",
      "fields": [
        {
          "name": "title",
          "description": "Task title",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "description": "Detailed task description",
          "type": "string",
          "required": true
        },
        {
          "name": "status",
          "description": "Current status (pending, in-progress, completed)",
          "type": "string",
          "required": true,
          "defaultValue": "pending"
        },
        {
          "name": "assignedTo",
          "description": "User ID of the assigned user",
          "type": "relationship",
          "relatedTo": "system:user"
        },
        {
          "name": "dueDate",
          "description": "Due date for the task",
          "type": "date"
        },
        {
          "name": "priority",
          "description": "Task priority (low, medium, high)",
          "type": "string",
          "required": true,
          "defaultValue": "medium"
        },
        {
          "name": "createdBy",
          "description": "User ID of the creator",
          "type": "relationship",
          "relatedTo": "system:user",
          "required": true
        },
        {
          "name": "tags",
          "description": "Task tags for categorization",
          "type": "json",
          "defaultValue": []
        },
        {
          "name": "attachmentFileName",
          "description": "Name of the attached file",
          "type": "string"
        },
        {
          "name": "attachmentFilePath",
          "description": "Path to the attached file",
          "type": "string"
        }
      ]
    }
  ],
  "authorizations": [
    {
      "id": "manage",
      "name": "Manage Tasks",
      "description": "Can create, edit, and delete tasks"
    },
    {
      "id": "assign",
      "name": "Assign Tasks",
      "description": "Can assign tasks to other users"
    },
    {
      "id": "view-all",
      "name": "View All Tasks",
      "description": "Can view tasks from all users"
    },
    {
      "id": "task-admin",
      "name": "Task Administration",
      "description": "Administrative access to all task operations",
      "contextual": true
    }
  ],
  "authorities": [
    {
      "id": "task-administrator",
      "name": "Task Administrator",
      "authorizations": ["manage", "assign", "view-all", "task-admin"]
    }
  ],
  "apiRoutes": [
    {
      "path": "list",
      "method": "GET",
      "description": "Get all tasks visible to the current user"
    },
    {
      "path": "create",
      "method": "POST",
      "description": "Create a new task"
    },
    {
      "path": "update",
      "method": "PATCH",
      "description": "Update an existing task"
    },
    {
      "path": "delete",
      "method": "DELETE",
      "description": "Delete a task"
    },
    {
      "path": "users",
      "method": "GET",
      "description": "Get all active users for task assignment"
    },
    {
      "path": "download",
      "method": "GET",
      "description": "Download a task attachment"
    }
  ],
  "applets": [
    {
      "id": "manager",
      "label": "Task Manager",
      "description": "Manage tasks with assignments, priorities, and status tracking",
      "target": "app",
      "component": "Manager"
    },
    {
      "id": "home-widget",
      "label": "Quick Task View",
      "description": "View and manage your tasks",
      "target": "home",
      "component": "HomeWidget"
    },
    {
      "id": "settings-widget",
      "label": "Task Settings",
      "description": "Configure your task preferences",
      "target": "user-settings",
      "component": "SettingsWidget"
    },
    {
      "id": "system-settings-widget",
      "label": "Task Manager",
      "description": "Configure system-wide task settings",
      "target": "system-settings",
      "component": "SystemSettingsWidget"
    }
  ]
}
