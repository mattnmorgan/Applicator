{
  "id": "files",
  "name": "Files",
  "version": {
    "major": 1,
    "minor": 2,
    "dev": 3
  },
  "author": "Matthew Morgan",
  "contactEmail": "matthew@morgantech.info",
  "description": "File management system for viewing and managing files across applications",
  "dependencies": {},
  "apiRoutes": [
    {
      "path": "upload",
      "method": "POST",
      "handler": "upload",
      "description": "Upload a file to a directory"
    },
    {
      "path": "download",
      "method": "GET",
      "handler": "download",
      "description": "Download a file"
    },
    {
      "path": "delete",
      "method": "DELETE",
      "handler": "delete",
      "description": "Delete a file"
    },
    {
      "path": "rename",
      "method": "PUT",
      "handler": "rename",
      "description": "Rename a file"
    },
    {
      "path": "move",
      "method": "PUT",
      "handler": "move",
      "description": "Move a file to a different directory"
    },
    {
      "path": "copy",
      "method": "POST",
      "handler": "copy",
      "description": "Copy a file to a different directory"
    },
    {
      "path": "list",
      "method": "GET",
      "handler": "list",
      "description": "List files in a directory"
    },
    {
      "path": "info",
      "method": "GET",
      "handler": "info",
      "description": "Get file information"
    },
    {
      "path": "mkdir",
      "method": "POST",
      "handler": "mkdir",
      "description": "Create a new directory"
    }
  ],
  "subApps": [
    {
      "id": "browser",
      "label": "File Browser",
      "description": "Browse and manage files across applications",
      "component": "Browser",
      "widgets": [
        {
          "id": "files-home-widget",
          "name": "Quick File Access",
          "description": "Quick access to recent files",
          "target": "home",
          "component": "HomeWidget",
          "appId": "files:browser"
        }
      ]
    }
  ]
}
